# Copy to .env and fill in. .env is git-ignored.

# LLM for scene writing: mira | groq | gemini | openrouter
PINCH_LLM_PROVIDER=groq
PINCH_LLM_API_KEY=
# PINCH_LLM_MODEL=           # optional, overrides the provider default
# PINCH_LLM_BASE_URL=        # optional, any other OpenAI-compatible endpoint

# Only needed if tesseract.exe isn't on PATH or in D:\Tesseract-OCR
# PINCH_TESSERACT_CMD=D:\Tesseract-OCR\tesseract.exe

# Image generation: local (SD-Turbo on GPU) | huggingface (HF_TOKEN) | pollinations (POLLINATIONS_TOKEN) | placeholder
# HF_TOKEN=
# POLLINATIONS_TOKEN=
PINCH_IMAGE_BACKEND=local

# Where Hugging Face models are downloaded (keep off a full C: drive)
HF_HOME=D:/tmp/hf
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Comic style: story (acted out in person, default) | texting (each person on their phone)
PINCH_SCENE_MODE=story

# Emoji reading (parked feature): on | off (default)
# PINCH_EMOJI=on

# Optional expression LoRA (see reports/lora_ab.json). Off unless set.
# PINCH_LORA=models/lora/expressions
# PINCH_LORA_SCALE=0.5
